    }
  ],
  "rules": [
    {
      "topic": "护盾",
      "rule": "curSp 从初始 shp 开始，按实际执行的 bb_shps/att_shps/sb_shps/ab_shps 累加；setter 不截断为零或生命上限；AfterAttackCommand 只最终写入 ahp/avg，不写入 ashp。"
    },
    {
      "topic": "Buff 成员",
      "rule": "初始 bfs（队伍 ppbf.pbid + pcbfs）保留重复；bd_bfs/ad_bfs 元组 1 增加、0 删除第一个匹配项。隐藏 Buff 不剔除。次数是成员记录数，不能无依据解释成层数。旧 ba/bc/aa/ac_bfs 没有当前命令调用，不重复应用。"
    },
    {
      "topic": "分组",
      "rule": "普通模式：每个对象自行排序 changeset，以各自数组索引并行推进；绝不全局合并组号。playOrderType=1 才 fillWithMaxChangeSetId，技能前补 0..max（含末位），技能后补到 max(beforeMax,afterMax) 之前。"
    },
    {
      "topic": "组内",
      "rule": "任一对象本组出现 buffWaitType>0 的新增 Buff 时，整组先处理显示 Buff，再处理生命/护盾、气势；否则先处理生命/护盾，再处理气势与 Buff。缺少等待配置时仅展示组末状态。"
    },
    {
      "topic": "最终校准与特殊记录",
      "rule": "技能后每组先 AfterAttackCommand，再 AfterAttackResultObjectCommand；达到该对象最后后置组时先校准 trl 的 ahp/avg，再校准 cn，然后才处理本组 rl。t=2 的生命及上限重设可覆盖本组的 ahp。prl 不参加最终 ahp/avg 校准。"
    },
    {
      "topic": "技能数值",
      "rule": "PlayEffectCommand 仅处理 isse=true 的 trl；有生效目标才处理施放者 cn 的 att 数值。isse=false 不取消前后置 Buff/数值。目标 att 数组由 EffectSplitData 求和再分配动画，文字版展示同阶段总额，不伪造随机气泡帧。"
    },
    {
      "topic": "反击",
      "rule": "近身命令 CounterCommand 在技能结算后、技能后分组前；仅一个生效 trl 且 issb=true 时执行，交换施放/目标，消费对应 sb 数组。"
    },
    {
      "topic": "同一身份",
      "rule": "Before/AfterAttackCommand 的目标 HP/SP 若目标就是施放者则跳过；气势与 Buff 仍沿各记录消费。"
    },
    {
      "topic": "组合技能",
      "rule": "按 ComboBuffsConfigXML，倒序查找 buffs 中当前成员记录包含的 ID，以对应 targetSkillIds 获取播放配置。"
    },
    {
      "topic": "队伍行动",
      "rule": "BattleRepresenter 不使用普通技能的 fillWithMaxChangeSetId；BufferExecuteDefine 的 actionResId>0 才播放队伍技能特效，否则采用仅前后置阶段的 RepresenterSimpleAttackCommand。"
    }
  ],
  "limits": [
    "依据是下载时的官方客户端，不宣称已取得每份历史日志对应的历史配置。",
    "重建的是客户端数据状态和命令边界；动画并行帧、随机气泡分配、形态换位画面仍不补造。",
    "未识别字段完整保留，格式或配置不足时显示待核实。"
  ],
