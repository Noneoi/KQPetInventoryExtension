  "confirmedRules": [
    {
      "topic": "green summon border",
      "rule": "cts[].ics maps directly to FighterInfo.isSummoned. Use Fighter.summoned. is is initial summon-called-out, not the classification itself. Pending summoned units remain classified as summoned while presence is shown separately."
    },
    {
      "topic": "clone separation",
      "rule": "ias and ibs mean isSelfReplication and isSelfReplicationCalledOut. Clone alone does not establish summon or Yuan-neng status."
    },
    {
      "topic": "chaser separation",
      "rule": "icr means isChaser. SetupFighterCommand pairs a chaser with a non-chaser at the same x/y for its origin avatar. Chaser alone gives no Yuan-neng evidence."
    },
    {
      "topic": "Yuan-neng definition",
      "rule": "Official FormationPanelV3 labels the non-self transform selector 元能技. ELEMENT_SKILL=元素技(type0,attribute) and ENERGIZE_SKILL=赋能技(type1,buff). SELF_ELEMENT_SKILL=幻元技(type2,self) is separate."
    },
    {
      "topic": "pink target when formation is available",
      "rule": "Use a battle-corresponding formation tsd transform section whose official config skillType is 0 or 1, then its target ID/effect-index map (petHasTransformEffect). Match team+player+id. Preserve both green and pink indicators if both hold."
    }
  ],
  "unverified": [
    {
      "field": "cts[].ibat",
      "status": "unverified meaning",
      "finding": "No reader or direct field name found in the checked Flash and H5 client packages. Attribute-change correlation below is observation, not semantic proof. Do not label this flag 元能 until independent evidence confirms it."
    },
    {
      "topic": "standalone replay pink target",
      "status": "missing authoritative target link",
      "finding": "All 500 logs omit formation tsd/transformSkillInfo, so direct target selection is unavailable. Conservative element-target recognition can separately be labelled 官方配置与日志唯一匹配 when the current official provider/effect and all initial observations match uniquely. Pure energize, self transforms and ambiguous cases remain unassigned."
    }
  ],
